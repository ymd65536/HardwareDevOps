[vendor]
repo_id = hardware-devops-fff
name = Hardware DevOps
config_version = 2.0.0

[printer_model:HOMEFDM]
name = Home FDM
variants = 0.4
technology = FFF
family = Home
default_materials = Generic PLA @Home FDM

[print:*common*]
layer_height = 0.2
first_layer_height = 0.2
perimeters = 3
fill_density = 15%
travel_speed = 180
first_layer_speed = 25
perimeter_speed = 60
infill_speed = 80
solid_infill_speed = 70
top_solid_infill_speed = 60
output_filename_format = [input_filename_base].gcode

[print:0.20mm Standard @Home FDM]
inherits = *common*

[print:0.20mm Standard @Home FDM (0.4 mm nozzle)]
inherits = *common*
compatible_printers_condition = nozzle_diameter[0]==0.4

[filament:*common*]
filament_diameter = 1.75
extrusion_multiplier = 1
filament_type = PLA
bed_temperature = 60
first_layer_bed_temperature = 60
first_layer_temperature = 210
temperature = 210

[filament:Generic PLA @Home FDM]
inherits = *common*

[filament:Generic PLA @Home FDM (0.4 mm nozzle)]
inherits = *common*
compatible_printers_condition = nozzle_diameter[0]==0.4

[printer:*common*]
printer_technology = FFF
gcode_flavor = marlin
bed_shape = 0x0,220x0,220x220,0x220
nozzle_diameter = 0.4
max_print_height = 220
printer_notes = "HOMEFDM"
start_gcode = "G28\nG1 Z5 F3000\nM104 S[first_layer_temperature]\nM140 S[first_layer_bed_temperature]\nM190 S[first_layer_bed_temperature]\nM109 S[first_layer_temperature]\nG92 E0\nG1 E3 F200\nG92 E0"
end_gcode = "M104 S0\nM140 S0\nG91\nG1 E-2 F300\nG1 Z5 F3000\nG90\nM84"

[printer:Home FDM]
inherits = *common*
printer_model = HOMEFDM
printer_variant = 0.4
default_filament_profile = Generic PLA @Home FDM
default_print_profile = 0.20mm Standard @Home FDM

[printer:Home FDM (0.4 mm nozzle)]
inherits = *common*
printer_model = HOMEFDM
printer_variant = 0.4
default_filament_profile = Generic PLA @Home FDM (0.4 mm nozzle)
default_print_profile = 0.20mm Standard @Home FDM (0.4 mm nozzle)
